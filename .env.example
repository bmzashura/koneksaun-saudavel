# Koneksaun Saudavel — Environment Variables
# Copy to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# WHOISJSON.com API (https://whoisjson.com)
# Free tier: 1,000 requests/month
# Get your API key at: https://whoisjson.com/login
WHOIS_API_KEY=YOUR_WHOISJSON_API_KEY

# Optional: Debug mode (set to True for development only)
DEBUG=False
