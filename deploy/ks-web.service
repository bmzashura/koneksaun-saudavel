[Unit]
Description=Koneksaun Saudavel Web Application
Documentation=https://github.com/bmzashura/koneksaun-saudavel
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ks/koneksaun-saudavel
Environment="PATH=/opt/ks/koneksaun-saudavel/venv/bin"
Environment="WHOIS_API_KEY=YOUR_WHOISJSON_API_KEY"
ExecStart=/opt/ks/koneksaun-saudavel/venv/bin/python3 -m flask run --host=0.0.0.0 --port=8080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ks-web
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ks/koneksaun-saudavel
PrivateTmp=true

[Install]
WantedBy=multi-user.target
