[Unit]
Description=Koneksaun Saudavel DNS Server
Documentation=https://github.com/bmzashura/koneksaun-saudavel
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ks/koneksaun-saudavel
Environment="PATH=/opt/ks/koneksaun-saudavel/venv/bin"
ExecStart=/opt/ks/koneksaun-saudavel/venv/bin/python3 app/dns_server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ks-dns

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ks/koneksaun-saudavel
PrivateTmp=true

[Install]
WantedBy=multi-user.target
